# UD5 (Python) — Nginx de laboratorio, IAW ASIR 2.º (el mismo que en la UD4)
# Nginx NO ejecuta Python: le pasa la petición HTTP al contenedor «app» (Gunicorn, app:8000).
FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends nginx curl ca-certificates procps nano \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default
EXPOSE 80 443
